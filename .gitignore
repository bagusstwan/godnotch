# =============================================================
# godnotch .gitignore
# =============================================================

# --- Build output (Rust / Cargo) ---
/target/
/dist/
**/*.rs.bk
*.pdb

# --- Internal files (local only, never published) ---
/docs/
/AGENTS.md

# --- Secrets and local environment ---
.env
.env.*
*.pem
*.key

# --- Logs and temporary files ---
*.log
*.tmp

# --- Editor and IDE ---
.vscode/
.idea/

# --- OS metadata ---
Thumbs.db
Desktop.ini
.DS_Store